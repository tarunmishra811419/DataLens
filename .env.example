# ============================================================
# DataLens Environment Configuration Template
# Copy this file to .env (for local dev) or set these in Render / Vercel
# ============================================================

# API Base URL (leave empty for local proxy, or point to production/localhost)
VITE_API_URL=https://datalens-etlt.onrender.com

# ------------------------------------------------------------
# Firebase Authentication (Google Sign-In)
# How to get these values (takes ~2 minutes):
# 1. Visit https://console.firebase.google.com and click "Add project" (DataLens)
# 2. In project settings, click the "</>" (Web) icon to register a web app
# 3. Copy the firebaseConfig keys below:
# 4. In Firebase Console -> Authentication -> Sign-in method:
#    Enable "Google" provider
# ------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
